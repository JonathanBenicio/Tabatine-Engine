{
  "stryker-config": {
    "project": "Tabatine.Infrastructure.csproj",
    "test-projects": [
      "src/Tabatine.Worker.IntegrationTests/Tabatine.Worker.IntegrationTests.csproj"
    ],
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 75,
      "low": 60,
      "break": 50
    },
    "mutate": [
      "Services/**/*.cs",
      "Repositories/**/*.cs",
      "!Data/Configurations/**/*.cs",
      "!Data/Migrations/**/*.cs",
      "!GlobalUsings.cs"
    ],
    "verbosity": "info",
    "language-version": "latest"
  }
}

# Omie API Credentials
Omie__AppKey=your_app_key_here
Omie__AppSecret=your_app_secret_here

# Telegram Notification Settings
# Use double underscore __ for nested properties
Telegram__BotToken=your_bot_token_here
Telegram__ChatId=your_chat_id_here

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Database=postgres;Username=postgres;Password=...

# App Settings
SyncIntervalInMinutes=15
